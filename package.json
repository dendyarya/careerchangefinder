{
  "name": "careerchangefinder",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "etl": "python3 scripts/etl/build.py && python3 scripts/etl/build_tests.py && python3 scripts/etl/build_situations.py && python3 scripts/etl/verify.py && python3 scripts/etl/verify_situations.py && python3 scripts/etl/verify_tests.py && python3 scripts/etl/report.py",
    "check": "npm run typecheck && npm run lint && npm test",
    "qa": "python3 scripts/qa/audit_html.py && python3 scripts/qa/check_pages_vs_data.py"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "^5.8.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@keystar/ui": "0.10.0",
    "@keystatic/core": "0.6.9",
    "@keystatic/next": "5.0.5",
    "@mdx-js/mdx": "3.1.1",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-aria": "3.50.0",
    "react-dom": "19.3.1",
    "react-stately": "3.48.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5"
  },
  "engines": {
    "node": ">=22"
  }
