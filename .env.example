# Copy to .env.local (never commit real values).
# Set to "production" only on the production server; anything else = noindex.
SITE_ENV=development

# Keystatic GitHub mode (created by the Keystatic GitHub App setup at /keystatic)
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
# Set to 1 to test GitHub mode with `npm run dev`
KEYSTATIC_GITHUB=
